# Base URL of the FastAPI backend. Leave empty in local dev to use the Vite proxy (/api -> :8000).
VITE_API_BASE_URL=
# Supabase project URL and publishable (anon) key. Safe to expose in the browser;
# data access is enforced by the API and by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
