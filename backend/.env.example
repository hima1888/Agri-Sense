# Copy to .env and adjust. All values are optional in Phase 1.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Postgres connection string (keep secret, never commit).
# Local Docker:  postgresql://agrisense:agrisense_local_dev@127.0.0.1:54329/agrisense
# Supabase:      Project -> Connect -> Session pooler (port 5432) URL
DATABASE_URL=postgresql://agrisense:agrisense_local_dev@127.0.0.1:54329/agrisense

# Supabase Auth. Tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# Local:  http://127.0.0.1:54321  (npm run auth:start in the repo root)
# Hosted: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Only for legacy projects still signing with the shared HS256 secret (keep secret):
SUPABASE_JWT_SECRET=

# Automatic alerts (Phase 17): background rule evaluation for every farm.
ALERTS_ENABLED=true
ALERT_INTERVAL_SECONDS=300
